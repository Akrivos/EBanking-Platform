@model EBanking.Web.Areas.Customer.ViewModels.AccountBalanceViewModel

@{
    ViewData["Title"] = "Account Balance";
}

<div class="container mt-4">
    <h2 class="mb-1">Account Balance</h2>
    <p class="text-muted mb-4">Check your available balance in euro and US dollar.</p>

    <div class="row">
        <div class="col-md-7 col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h5 class="card-title mb-3">@Model.AccountNumber</h5>

                    <p class="mb-3">
                        <strong>Branch:</strong> @Model.Branch
                    </p>

                    <hr />

                    <div class="mb-3">
                        <label class="form-label text-muted">Balance in EUR</label>
                        <div class="form-control bg-light">@Model.BalanceEuro.ToString("N2") €</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted">EUR to USD Rate</label>
                        <div class="form-control bg-light">@Model.ExchangeRateUsd.ToString("N4")</div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-muted">Balance in USD</label>
                        <div class="form-control bg-light">@Model.BalanceUsd.ToString("N2") $</div>
                    </div>

                    <div class="d-flex gap-2">
                        <a asp-area="Customer"
                               asp-controller="Banking"
                               asp-action="MyAccounts"
                               class="btn btn-outline-secondary">
                            Back to My Accounts
                        </a>

                        <a asp-area="Customer"
                               asp-controller="Dashboard"
                               asp-action="Index"
                               class="btn btn-outline-dark">
                            Back to Dashboard
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>