@model EBanking.Web.Areas.Customer.ViewModels.TransferToOwnViewModel

@{
    ViewData["Title"] = "Transfer to My Account";
}

<div class="container mt-4">
    <h2 class="mb-1">Transfer to My Account</h2>
    <p class="text-muted mb-4">Transfer money between your own bank accounts.</p>

    <div class="row">
        <div class="col-md-6">
            <form asp-action="TransferToOwn" method="post">
                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="FromAccountNumber" class="form-label">From Account</label>
                    <select asp-for="FromAccountNumber" asp-items="Model.AvailableAccounts" class="form-select">
                        <option value="">Select source account</option>
                    </select>
                    <span asp-validation-for="FromAccountNumber" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ToAccountNumber" class="form-label">To Account</label>
                    <select asp-for="ToAccountNumber" asp-items="Model.AvailableAccounts" class="form-select">
                        <option value="">Select destination account</option>
                    </select>
                    <span asp-validation-for="ToAccountNumber" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Amount" class="form-label">Amount (€)</label>
                    <input asp-for="Amount" class="form-control" placeholder="Enter amount in euro" />
                    <span asp-validation-for="Amount" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Transfer</button>
                    <a asp-area="Customer"
                           asp-controller="Banking"
                           asp-action="MyAccounts"
                           class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}