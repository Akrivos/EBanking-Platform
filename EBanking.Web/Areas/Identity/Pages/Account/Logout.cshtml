@page
@model LogoutModel

@{
    ViewData["Title"] = "Logout";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">

            <div class="card shadow-sm border-0">
                <div class="card-body p-4 text-center">

                    <img src="~/images/ebanking-logo.png"
                         alt="EBanking Logo"
                         style="height:70px;"
                         class="mb-3" />

                    @if (User.Identity?.IsAuthenticated ?? false)
                    {
                        <h2 class="fw-bold mb-3">Sign out</h2>

                        <p class="text-muted mb-4">
                            Are you sure you want to log out of your EBanking account?
                        </p>

                        <form asp-area="Identity"
                              asp-page="/Account/Logout"
                              asp-route-returnUrl="@Url.Page("/", new { area = "" })"
                              method="post">

                            <button type="submit"
                                    class="btn btn-danger btn-lg w-100 mb-3">
                                Log out
                            </button>
                        </form>

                        <a asp-area=""
                               asp-controller="Home"
                               asp-action="Index"
                               class="btn btn-outline-secondary w-100">
                            Cancel
                        </a>
                    }
                    else
                    {
                        <h2 class="fw-bold mb-3 text-success">
                            Logged out successfully
                        </h2>

                        <p class="text-muted mb-4">
                            You have successfully signed out of EBanking.
                        </p>

                        <a asp-area=""
                               asp-controller="Home"
                               asp-action="Index"
                               class="btn btn-primary btn-lg w-100">
                            Return to Home
                        </a>
                    }

                </div>
            </div>

        </div>
    </div>
</div>