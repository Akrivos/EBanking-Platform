@model EBanking.Web.Areas.Staff.ViewModels.Accounts.DeleteAccountViewModel

@{
    ViewData["Title"] = "Delete Account";
}

<div class="container mt-4">
    <h2 class="mb-1">Delete Bank Account</h2>
    <p class="text-muted mb-4">Please confirm that you want to delete this account.</p>

    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <div class="card border-danger shadow-sm">
        <div class="card-body">
            <h5 class="card-title text-danger">Warning</h5>
            <p class="card-text">
                This action will permanently remove the selected bank account.
            </p>

            <dl class="row mt-4">
                <dt class="col-sm-4">Account Number</dt>
                <dd class="col-sm-8">@Model.AccountNumber</dd>

                <dt class="col-sm-4">Customer AFM</dt>
                <dd class="col-sm-8">@Model.CustomerAfm</dd>

                <dt class="col-sm-4">Balance</dt>
                <dd class="col-sm-8">@Model.Balance.ToString("N2")</dd>

                <dt class="col-sm-4">Currency</dt>
                <dd class="col-sm-8">@Model.Currency</dd>

                <dt class="col-sm-4">Branch</dt>
                <dd class="col-sm-8">@Model.Branch</dd>

                <dt class="col-sm-4">Account Type</dt>
                <dd class="col-sm-8">@Model.AccountType</dd>
            </dl>

            <form asp-action="DeleteConfirmed" method="post" class="mt-4">
                <input asp-for="AccountNumber" type="hidden" />
                <input asp-for="CustomerAfm" type="hidden" />
                <input asp-for="Balance" type="hidden" />
                <input asp-for="Currency" type="hidden" />
                <input asp-for="Branch" type="hidden" />
                <input asp-for="AccountType" type="hidden" />

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger">Delete Account</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>