@model EBanking.Web.Areas.Customer.ViewModels.TransferToThirdPartyViewModel

@{
    ViewData["Title"] = "Transfer to Third Party";
}

<div class="container mt-4">
    <h2 class="mb-1">Transfer to Third Party</h2>
    <p class="text-muted mb-4">Send money to another bank account.</p>

    <div class="row">
        <div class="col-md-6">
            <form asp-action="TransferToThirdParty" method="post">
                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="FromAccountNumber" class="form-label">From Account</label>
                    <select asp-for="FromAccountNumber" asp-items="Model.AvailableAccounts" class="form-select">
                        <option value="">Select your account</option>
                    </select>
                    <span asp-validation-for="FromAccountNumber" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ToAccountNumber" class="form-label">To Account Number</label>
                    <input asp-for="ToAccountNumber" class="form-control" placeholder="Enter destination account number" />
                    <span asp-validation-for="ToAccountNumber" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Amount" class="form-label">Amount (€)</label>
                    <input asp-for="Amount" class="form-control" />
                    <span asp-validation-for="Amount" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-warning">Transfer</button>
                    <a asp-action="MyAccounts" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}