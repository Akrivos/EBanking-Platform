@model IEnumerable<MellonBank.Web.Areas.Staff.ViewModels.Accounts.GetAccountDetailsViewModel>

@{
    ViewData["Title"] = "Accounts";
}

<div class="container mt-4">
    <h2 class="mb-1">Bank Accounts</h2>
    <p class="text-muted mb-4">View and manage all customer bank accounts.</p>

    <p>
        <a asp-action="Create" class="btn btn-primary">
            Create New Account
        </a>
    </p>

    @if (Model is null || !Model.Any())
    {
        <div class="alert alert-info">
            No accounts have been created yet.
        </div>
    }
    else
    {
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>Account Number</th>
                    <th>Customer AFM</th>
                    <th>Balance</th>
                    <th>Currency</th>
                    <th>Branch</th>
                    <th>Account Type</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.AccountNumber</td>
                        <td>@item.CustomerAfm</td>
                        <td>@item.Balance.ToString("N2")</td>
                        <td>@item.Currency</td>
                        <td>@item.Branch</td>
                        <td>@item.AccountType</td>
                        <td>
                            <a asp-action="Details" asp-route-accountNumber="@item.AccountNumber">Details</a> |
                            <a asp-action="Edit" asp-route-accountNumber="@item.AccountNumber">Edit</a> |
                            <a asp-action="Delete" asp-route-accountNumber="@item.AccountNumber">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>