@{
    ViewData["Title"] = "Home";
}

<div class="container">
    <div class="text-center mt-5">

        <img src="~/images/mellonbank.png"
             alt="MellonBank Logo"
             style="height:120px;"
             class="mb-4" />

        <h1 class="display-4 fw-bold text-primary">
            Welcome to MellonBank
        </h1>

        <p class="lead text-muted">
            Secure digital banking for staff and customers.
        </p>

        <div class="mt-4">
            @if (!User.Identity!.IsAuthenticated)
            {
                <a asp-area="Identity"
                       asp-page="/Account/Login"
                       class="btn btn-primary btn-lg px-4">
                    Login
                </a>
            }
            else if (User.IsInRole("Staff"))
            {
                <a asp-area="Staff"
                       asp-controller="Dashboard"
                       asp-action="Index"
                       class="btn btn-primary btn-lg px-4">
                    Go to Staff Dashboard
                </a>
            }
            else if (User.IsInRole("Customer"))
            {
                <a asp-area="Customer"
                       asp-controller="Dashboard"
                       asp-action="Index"
                       class="btn btn-primary btn-lg px-4">
                    Go to Customer Dashboard
                </a>
            }
        </div>

    </div>

    <div class="row mt-5 g-4">

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <h5>Secure Access</h5>
                    <p>Role-based authentication for staff and customers.</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <h5>Account Management</h5>
                    <p>Create and manage customers, staff users, and accounts.</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <h5>Money Transfers</h5>
                    <p>Transfer funds between own accounts or third parties.</p>
                </div>
            </div>
        </div>

    </div>

</div>