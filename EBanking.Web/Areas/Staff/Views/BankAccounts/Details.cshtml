@model EBanking.Web.Areas.Staff.ViewModels.Accounts.GetAccountDetailsViewModel

@{
    ViewData["Title"] = "Account Details";
}

<div class="container mt-4">
    <h2 class="mb-1">Account Details</h2>
    <p class="text-muted mb-4">View detailed information about the selected bank account.</p>

    <div class="card shadow-sm p-4">
        <dl class="row">
            <dt class="col-sm-4">Account Number</dt>
            <dd class="col-sm-8">@Model.AccountNumber</dd>

            <dt class="col-sm-4">Customer AFM</dt>
            <dd class="col-sm-8">@Model.CustomerAfm</dd>

            <dt class="col-sm-4">Balance</dt>
            <dd class="col-sm-8">@Model.Balance.ToString("N2")</dd>

            <dt class="col-sm-4">Currency</dt>
            <dd class="col-sm-8">@Model.Currency</dd>

            <dt class="col-sm-4">Branch</dt>
            <dd class="col-sm-8">@Model.Branch</dd>

            <dt class="col-sm-4">Account Type</dt>
            <dd class="col-sm-8">@Model.AccountType</dd>
        </dl>

        <div class="mt-4 d-flex gap-2">
            <a asp-action="Edit" asp-route-accountNumber="@Model.AccountNumber" class="btn btn-primary">Edit</a>
            <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
        </div>
    </div>
</div>