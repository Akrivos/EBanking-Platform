@model EBanking.Web.Areas.Customer.ViewModels.TransactionsIndexViewModel
@using EBanking.Domain.Enums

@{
    ViewData["Title"] = "Transactions";
}

<div class="container py-4">

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body d-flex justify-content-between align-items-center">
            <div>
                <h2 class="mb-1">Transaction History</h2>
                <p class="text-muted mb-0">
                    Account: <strong>@Model.AccountNumber</strong>
                </p>
            </div>

            <span class="badge bg-primary">
                @Model.Transactions.Count Transactions
            </span>
        </div>
    </div>

    @if (!Model.Transactions.Any())
    {
        <div class="alert alert-info">
            No transactions found for this account.
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th>Date</th>
                                <th>Reference</th>
                                <th>From</th>
                                <th>To</th>
                                <th>Type</th>
                                <th>Status</th>
                                <th class="text-end">Amount</th>
                                <th></th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var transaction in Model.Transactions)
                            {
                                <tr>

                                    <td>
                                        @transaction.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                    </td>

                                    <td>
                                        <strong>@transaction.ReferenceCode</strong>
                                    </td>

                                    <td>
                                        @transaction.FromAccountNumber
                                    </td>

                                    <td>
                                        @transaction.ToAccountNumber
                                    </td>

                                    <td>
                                        @transaction.Type
                                    </td>

                                    <td>

                                        @if (transaction.Status == TransactionStatus.Completed)
                                        {
                                            <span class="badge bg-success">
                                                Completed
                                            </span>
                                        }
                                        else if (transaction.Status == TransactionStatus.Pending)
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Pending
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Failed
                                            </span>
                                        }

                                    </td>

                                    <td class="text-end fw-bold @transaction.AmountCssClass">
                                        @transaction.AmountPrefix €@transaction.Amount.ToString("N2")
                                    </td>

                                    <td class="text-end">

                                        <a asp-action="Details"
                                           asp-route-id="@transaction.Id"
                                           asp-route-accountNumber="@Model.AccountNumber"
                                           class="btn btn-sm btn-outline-primary">
                                            Details
                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>
                </div>

            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-4">

            <div class="text-muted">
                Page @Model.Page of @Model.TotalPages
            </div>

            <div class="d-flex gap-2">

                @if (Model.HasPreviousPage)
                {
                    <a asp-action="Index"
                       asp-route-accountNumber="@Model.AccountNumber"
                       asp-route-page="@(Model.Page - 1)"
                       asp-route-pageSize="@Model.PageSize"
                       class="btn btn-outline-secondary">
                        Previous
                    </a>
                }

                @if (Model.HasNextPage)
                {
                    <a asp-action="Index"
                       asp-route-accountNumber="@Model.AccountNumber"
                       asp-route-page="@(Model.Page + 1)"
                       asp-route-pageSize="@Model.PageSize"
                       class="btn btn-primary">
                        Next
                    </a>
                }

            </div>
        </div>
    }
</div>