@model EBanking.Web.Areas.Staff.ViewModels.Accounts.CreateBankAccountViewModel
@using EBanking.Domain.Enums
@using EBanking.Web
@using EBanking.Web.Models

@{
    ViewData["Title"] = "Create Bank Account";
}

<div class="container mt-4">
    <h2 class="mb-1">Create New Bank Account</h2>
    <p class="text-muted mb-4">Enter the required information to create a new bank account.</p>

    <div class="row">
        <div class="col-md-6">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="CustomerAfm" class="form-label">Customer AFM</label>
                    <input asp-for="CustomerAfm" class="form-control" placeholder="Enter customer AFM" />
                    <span asp-validation-for="CustomerAfm" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="InitialBalance" class="form-label">Initial Balance</label>
                    <input asp-for="InitialBalance" class="form-control" placeholder="Enter initial balance" />
                    <span asp-validation-for="InitialBalance" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Branch" class="form-label">Branch</label>
                    <input asp-for="Branch" class="form-control" placeholder="Enter branch name" />
                    <span asp-validation-for="Branch" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="AccountType" class="form-label">Account Type</label>
                    <select asp-for="AccountType" asp-items="Html.GetEnumSelectList<AccountType>()" class="form-select">
                        <option value="">Select account type</option>
                    </select>
                    <span asp-validation-for="AccountType" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Create Account</button>
                    <a asp-area="Staff" asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}